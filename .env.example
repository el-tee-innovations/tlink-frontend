# ============================================
# API Configuration
# ============================================

# Backend API Base URL
# Default: http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api


# ============================================
# Development Mode - JWT Authentication Bypass
# ============================================

# Enable development mode (disables JWT authentication)
# ⚠️ SET TO 'false' BEFORE COMMITTING OR DEPLOYING
# Values: true | false
# Default: false
#
# When set to 'true':
#   - Automatically logs in with mock user
#   - Uses mock JWT token for all requests
#   - Skips backend token validation
#   - Shows warning message in browser console
#   - Saves time during development/testing
#
# Example workflow:
#   1. Set this to 'true'
#   2. Set VITE_DEV_USER_ROLE to desired role
#   3. Restart dev server: npm run dev
#   4. You're now logged in as the mock user
#   5. Test features without authentication
#   6. Switch roles in browser console: switchDevModeRole('RECRUITER')
#
# Before deployment:
#   1. Set to 'false'
#   2. Commit and push
#   3. Verify with: npm run build
#
# ⚠️ NEVER USE IN PRODUCTION - BUILD STRIPS THIS VARIABLE
VITE_DEV_MODE=false

# Development user role (only used if VITE_DEV_MODE=true)
# Values: JOB_SEEKER | RECRUITER | ADMIN
# Default: JOB_SEEKER
#
# Examples:
#   VITE_DEV_USER_ROLE=JOB_SEEKER    # Test job seeker features
#   VITE_DEV_USER_ROLE=RECRUITER     # Test recruiter features
#   VITE_DEV_USER_ROLE=ADMIN         # Test admin features
#
# Can switch at runtime in browser console:
#   import { switchDevModeRole } from '@/utils/devMode'
#   switchDevModeRole('RECRUITER')
VITE_DEV_USER_ROLE=JOB_SEEKER


